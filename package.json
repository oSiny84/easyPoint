{
  "name": "canvacraft",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build --base=./ --assetsInlineLimit=0 && node scripts/prune-dist.mjs",
    "package": "npm run build && node scripts/package-release.mjs",
    "exe": "npm run build && node scripts/build-exe.mjs",
    "test:exe": "npm run exe && node scripts/test-exe.mjs",
    "test": "playwright test --config playwright.config.ts",
    "test:phase2": "playwright test --config playwright.phase2.config.ts",
    "test:release": "npm run build && playwright test --config playwright.release.config.ts"
  },
  "dependencies": {
    "@fontsource/do-hyeon": "5.3.0",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gamja-flower": "5.3.0",
    "@fontsource/jua": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "jszip": "3.10.2",
    "konva": "10.9.1",
    "mediabunny": "1.62.1",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
